503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc11"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc0f"},"type":"String","textContent":"Are CRM, AI Suite and AI Agent three separate plans?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc14"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc13"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc12"},"type":"String","textContent":"No. They are three product areas. There are two offerings: the Enterprise Optimization Suite (CRM plus AI Suite access) and the Enterprise Optimization Suite + AI Agent."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc1e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc19"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc17"},"type":"String","textContent":"What does pay-as-you-go mean for the AI Suite?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc1c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc1b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc1a"},"type":"String","textContent":"Access to the AI Suite comes with the Enterprise Optimization Suite at no additional subscription. When you choose to use an AI tool, that usage is billed as you go. If you do not use the tools, there is no AI usage to pay for. Usage is tracked in a billing dashboard."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc26"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc21"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc1f"},"type":"String","textContent":"Can I use the CRM without using any AI tools?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc24"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc23"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc22"},"type":"String","textContent":"Yes. AI Suite usage is optional. The CRM, pipelines, automations and KPI tracking work on their own."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc2e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc29"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc27"},"type":"String","textContent":"What is scoped separately?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc2c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc2b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc2a"},"type":"String","textContent":"Work that depends on your setup is scoped on a call. Examples include custom automations, custom drip campaigns, custom landing pages, third-party integrations, Slack alerts and dedicated accounting support."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc36"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc31"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc2f"},"type":"String","textContent":"What does support look like after launch?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc34"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc33"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc32"},"type":"String","textContent":"Every client has a dedicated channel with our team. You talk to a person, not a bot, and there is no ticket queue. Routine changes and edits are made at no extra cost. Substantial requests are quoted before any work starts."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc3e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc39"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc37"},"type":"String","textContent":"Does KPI DRIVER integrate with my existing tools?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc3c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc3b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc3a"},"type":"String","textContent":"KPI DRIVER works alongside phone systems, marketing tools and third-party platforms. Our tech team scopes and handles integration setup with you, so tell us what you run today on your discovery call."}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc46"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc41"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc3f"},"type":"String","textContent":"Where do I see pricing?"}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc44"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc43"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"e98fafc6-e28c-6c40-259e-e498ed72cc42"},"type":"String","textContent":"On your discovery call. We do not publish a rate card because the right setup depends on your team, your data and which AI tools you plan to use."}]}]}]}]}]}]},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbaca"},"type":"Block","styleNames":["cta"],"attributes":{"aria-labelledby":"cta-h"},"settings":{"tag":"section","visibility":true,"block":{"tag":"section"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbac9"},"type":"Block","styleNames":["wrap"],"settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbac5"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbabe"},"type":"Block","styleNames":["gearline","u-mb-28"],"attributes":{"aria-hidden":"true"},"settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbab7"},"type":"DOM","settings":{"tag":"i","visibility":true,"dom":{"tag":"i"}}},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbab9"},"type":"DOM","settings":{"tag":"i","visibility":true,"dom":{"tag":"i"}}},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbabb"},"type":"DOM","settings":{"tag":"i","visibility":true,"dom":{"tag":"i"}}},{"id":{"component":"6afa6ce5a6769cca503f0934","element":"282c0f4f-6498-988e-c91f-154ea9adbabd"},"type":"DOM","settings":{"tag":"i","visibility":true,"dom":{"tag":"i"}}}]},{"id":{"component":"6afa6ce5a6769cca503f0934","el