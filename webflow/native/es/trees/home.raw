ent":"70f81986-1a4f-f28d-7006-bfbd197d6802"},"type":"String","textContent":"Send us a message"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6804"},"type":"String","textContent":"."}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6847"},"type":"Block","styleNames":["kd-faq"],"settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d680e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6809"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6807"},"type":"String","textContent":"What is KPI DRIVER?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d680c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d680b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d680a"},"type":"String","textContent":"KPI DRIVER is a real estate business operations platform built by investors for investors. Its CRM connects lead capture, nurture, acquisitions, dispositions, transaction coordination, contractors and vendors, and owned and rental properties, with KPI tracking across all of them."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6816"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6811"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d680f"},"type":"String","textContent":"What do I get with the Enterprise Optimization Suite?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6814"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6813"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6812"},"type":"String","textContent":"The CRM and access to the AI Suite, together. There is no additional AI Suite subscription. Using the AI tools is optional, and you pay only for what you use."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d681e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6819"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6817"},"type":"String","textContent":"Is the AI Agent included?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d681c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d681b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d681a"},"type":"String","textContent":"No. The AI Agent is a separate, optional offering. Teams that want it choose the Enterprise Optimization Suite + AI Agent. You do not need the AI Agent to use the CRM or the AI Suite."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6826"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6821"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d681f"},"type":"String","textContent":"How much does KPI DRIVER cost?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6824"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6823"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6822"},"type":"String","textContent":"Pricing depends on your operation, so we cover it on a discovery call. Book a call and we will walk through fit, the two offerings, and how pay-as-you-go AI usage works."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d682e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6829"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6827"},"type":"String","textContent":"Do I need separate systems for document signatures, dispositions, or rentals?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d682c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d682b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d682a"},"type":"String","textContent":"No. KPI DRIVER includes dedicated pipelines for each process, plus built-in document signature tools, so contracts stay attached to the deal they belong to."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6836"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6831"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d682f"},"type":"String","textContent":"Will KPI DRIVER work if I am new to real estate or do not have a CRM yet?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6834"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6833"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6832"},"type":"String","textContent":"Yes. KPI DRIVER is designed for both new and established real estate businesses. New teams start with a streamlined setup. Established teams work with us on data migration and pipelines that match how they already operate."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d683e"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6839"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6837"},"type":"String","textContent":"Do you offer support and training?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d683c"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d683b"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d683a"},"type":"String","textContent":"Yes, and it is personal. Every client has a dedicated channel with our team and a dedicated account manager. There are no chatbots and no ticket queue, and we reply as soon as we can. Routine changes and edits are made at no extra cost. If a request is substantial, we send a quote first. A knowledge base of recorded walkthroughs inside the AI Suite covers the system on demand."}]}]}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6846"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6841"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d683f"},"type":"String","textContent":"How long does implementation take?"}]},{"id":{"component":"68974c57cac027f80fdf8828","element":"70f81986-1a4f-f28d-7006-bfbd197d6844"},"type":"Block","settings":{"tag":"div","visibility":true,"block":