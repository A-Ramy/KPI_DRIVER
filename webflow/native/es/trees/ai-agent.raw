nent":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b46916"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b46915"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b46914"},"type":"String","textContent":"They are listed AI Agent capabilities related to the phone numbers the agent uses. BYOC is short for bring your own carrier. We will explain how each applies to your numbers and carrier on a discovery call."}]}]}]},{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b46920"},"type":"DOM","settings":{"tag":"details","visibility":true,"dom":{"tag":"details"}},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b4691b"},"type":"DOM","settings":{"tag":"summary","visibility":true,"dom":{"tag":"summary"}},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b46919"},"type":"String","textContent":"How is the AI Agent different from AI Nurture?"}]},{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b4691e"},"type":"Block","settings":{"tag":"div","visibility":true,"block":{"tag":"div"}},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b4691d"},"type":"Paragraph","settings":{"visibility":true},"children":[{"id":{"component":"6afa191e7b59d3ca770d4e6a","element":"957ecdfb-0b9f-753d-67a6-e1f854b4691c"},"type":"String","textContent":"AI Nurture builds and schedules a tailored 60-day SMS and email campaign for a seller from your conversations and notes, and it does not require the AI Agent. The AI Agent is a separate offering that follows up with leads across its channels within your rules."}]}]}]},{"id":{"component":"6